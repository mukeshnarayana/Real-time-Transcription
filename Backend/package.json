    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemon": "^3.1.14",
